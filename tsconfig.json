{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@throne/shared-types": ["./packages/shared-types/src/index.ts"],
      "@throne/sim-core": ["./packages/sim-core/src/index.ts"],
      "@throne/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@throne/agent-runtime/live": [
        "./packages/agent-runtime/src/live-policy.ts"
      ],
      "@throne/agent-runtime/policy": [
        "./packages/agent-runtime/src/policy.ts"
      ],
      "@throne/agent-runtime/bribe": [
        "./packages/agent-runtime/src/bribe-policy.ts"
      ],
      "@throne/agent-runtime/action": [
        "./packages/agent-runtime/src/actor-action.ts"
      ],
      "@throne/agent-runtime/official": [
        "./packages/agent-runtime/src/official-policy.ts"
      ],
      "@throne/localization": ["./packages/localization/src/index.ts"],
      "@throne/scenario-mvp": ["./packages/scenario-mvp/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "vite.config.ts"
  ]
}
